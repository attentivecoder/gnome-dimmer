<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.screen-dimmer"
          path="/org/gnome/shell/extensions/screen-dimmer/">
    <key name="dim-level" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.0</default>
      <summary>Dim level</summary>
      <description>0 = no dimming, 1 = maximum dimming.</description>
    </key>
    <key name="max-opacity" type="d">
      <range min="0.1" max="0.98"/>
      <default>0.85</default>
      <summary>Maximum overlay opacity</summary>
      <description>Opacity of the black overlay when the slider is at its maximum. Keeps the screen from going fully black.</description>
    </key>
  </schema>
</schemalist>
